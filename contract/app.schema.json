{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omni.app",
  "title": "Omni app",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "module", "title", "state"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "module": {
      "enum": ["checklist", "scoreboard", "progress", "key_value"]
    },
    "title": { "type": "string", "minLength": 1 },
    "state": { "type": "object" }
  }
}
